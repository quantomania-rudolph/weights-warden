# Configuration read by ./h and by the MCP server. Real environment variables override these lines.
# --- default: the bundled toy transformer (0.1M-param GPT-2, induction task) so everything works out of the box
HARNESS_BACKEND=lm_backend:LMBackend
HARNESS_MODE=llm
HARNESS_BUDGET=6            # charged proposals per run
# --- switches for ablations (uncomment to use)
# HARNESS_RAW_VIEW=0        # hide raw weight values (summary-only arm)
# HARNESS_CAVEATS=0         # remove the one-line measurement caveats on tool outputs
# --- YOUR model: put your backend module on the path and name it (see docs/README_EXPOSURE.md and engine/any_model/lm_backend.py for a worked example)
# HARNESS_PYTHONPATH=/path/to/dir/containing/my_backend
# HARNESS_BACKEND=my_backend:MyBackend
# HARNESS_MODE=llm          # transformers / MLPs. Remove both HARNESS_* lines above to use the Nav2D demo mode instead
